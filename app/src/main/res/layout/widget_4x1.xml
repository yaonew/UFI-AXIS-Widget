<?xml version="1.0" encoding="utf-8"?>
<!--
    4×1 条形版：左侧本月流量大字（主角），右侧两行小字承载其余指标。

    上一版是四栏平铺、八个元素等权重，看起来只是一排零件；这一版只保留两个视觉分组，
    并让流量数字明显大一号，与 2×1 / 2×2 的版面语言保持一致。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:elevation="6dp"
    android:outlineProvider="background"
    android:background="@drawable/bg_widget_mask_transparent">

    <!-- 背景图层 -->
    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/bg_widget_mask" />

    <!-- 描边层 -->
    <ImageView
        android:id="@+id/widget_bg_stroke"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/bg_widget_stroke" />

    <!-- 正常数据内容区。左右内边距与 4×2 对齐（同为 250dp 宽），见 widget_1x1.xml 的说明 -->
    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <!-- 左：本月流量大字 + 标签与型号 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:gravity="bottom">

                <TextView
                    android:id="@+id/tv_flow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#777777"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/tv_flow_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:layout_marginBottom="1dp"
                    android:text="GB"
                    android:textColor="#777777"
                    android:textSize="11sp"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- 大字下方只留标签；型号挪到右上角那行的末尾，和其余状态项排在一起 -->
            <TextView
                android:id="@+id/tv_flow_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="本月流量"
                android:textColor="#777777"
                android:textSize="10sp"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!--
            右：图标行 + 小字行。

            两行各占一半高度（0dp + weight=1）、各自在自己那半里竖向居中，效果就是
            一行偏上、一行偏下，和左边那个大字形成对称版面 —— 两行紧挨着居中时，
            右半边看着像一小坨字。
            这里刻意不用「weight=1 的空白 View」去撑：RemoteViews 的 inflater 只放行
            带 @RemoteView 注解的类，塞 <View> 会抛 InflateException，桌面上表现为
            「载入时出现问题」，整个组件都不显示。
        -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:orientation="vertical"
            android:gravity="end">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/iv_signal_bars"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_signal_0"
                    android:scaleType="fitCenter" />

                <ImageView
                    android:id="@+id/iv_network"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginStart="2dp"
                    android:src="@drawable/ic_network_4g"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/tv_no_network"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:text="无网络"
                    android:textColor="#777777"
                    android:textSize="9sp"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/iv_battery"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="7dp"
                    android:src="@drawable/ic_battery_0"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/tv_battery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="1dp"
                    android:text="--"
                    android:textColor="#777777"
                    android:textSize="11sp"
                    android:includeFontPadding="false" />

                <!--
                    型号排在这一行末尾（电量右边）。maxWidth 是必需的：这一列是
                    wrap_content，型号越长整列越宽，左边大字那栏是 weight=1、会被挤到
                    把数字切掉，所以给型号一个上限，超出就省略号。
                -->
                <ImageView
                    android:id="@+id/iv_router"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_marginStart="7dp"
                    android:layout_marginEnd="2dp"
                    android:src="@drawable/ic_router"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/tv_model"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="72dp"
                    android:text="--"
                    android:textColor="#777777"
                    android:textSize="11sp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_signal_dbm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#777777"
                    android:textSize="9sp"
                    android:includeFontPadding="false"
                    android:maxLines="1" />

                <ImageView
                    android:id="@+id/iv_temp"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_marginStart="6dp"
                    android:src="@drawable/ic_temp"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/tv_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="1dp"
                    android:text="--"
                    android:textColor="#777777"
                    android:textSize="9sp"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/tv_update_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="--"
                    android:textColor="#777777"
                    android:textSize="9sp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- 错误覆盖层：紧凑型，横向 icon + text -->
    <LinearLayout
        android:id="@+id/widget_error_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone"
        android:clickable="false">

        <ImageView
            android:id="@+id/widget_error_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_router_off"
            android:scaleType="fitCenter" />

        <!-- 重试中自转的加载圈：与 widget_error_icon 同尺寸同位，applyStateOverlay 里二选一显示 -->
        <ProgressBar
            android:id="@+id/pb_overlay_loading"
            style="@android:style/Widget.ProgressBar.Small.Inverse"
            android:indeterminate="true"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="6dp"
            android:indeterminateTint="@android:color/white"
            android:visibility="gone"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/widget_error_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设备连接失败"
            android:textColor="#777777"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ========= 右下角断连角标：断连时保留数据、只在此处提示；点一下变转圈，再点触发刷新 =========
         三态由 renderConnBadge 切换：
         - 断连未点     → iv_conn_badge 显示断开图标；
         - 已上膛       → pb_conn_badge_loading 自转（再点一下才触发真实刷新）；
         - 刷新进行中   → iv_conn_badge 隐藏、由 pb_conn_badge_loading 继续转圈顶替。
         用 ProgressBar 而不是 ImageView 转圈：AppWidget 里 ImageView 挂不上动画，
         系统 ProgressBar 的 indeterminate 转圈是桌面组件中唯一能自驱动运行的加载动效。 -->
    <ImageView
        android:id="@+id/iv_conn_badge"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="2dp"
        android:padding="3dp"
        android:background="@drawable/bg_conn_badge"
        android:src="@drawable/ic_router_off"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <ProgressBar
        android:id="@+id/pb_conn_badge_loading"
        style="@android:style/Widget.ProgressBar.Small.Inverse"
        android:indeterminate="true"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="2dp"
        android:background="@drawable/bg_conn_badge"
        android:indeterminateTint="@android:color/white"
        android:visibility="gone"
        android:importantForAccessibility="no" />

</FrameLayout>
