<?xml version="1.0" encoding="utf-8"?>
<!--
    2×2 方块版：型号/信号/制式/电量在顶栏，中间一个流量大字，底部两行小字。

    顶栏容得下这五项的前提是型号那格 weight=1 且 ellipsize：宽度不够时先牺牲型号，
    右上角这组状态图标始终完整 —— 状态是「一眼扫」的信息，型号看个前缀就够。
    行间距统一收到 1~2dp，靠中间大字块的 weight 吸收剩余高度。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:elevation="6dp"
    android:outlineProvider="background"
    android:background="@drawable/bg_widget_mask_transparent">

    <!-- 背景图层 -->
    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/bg_widget_mask" />

    <!-- 描边层 -->
    <ImageView
        android:id="@+id/widget_bg_stroke"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/bg_widget_stroke" />

    <!--
        正常数据内容区。

        上下留 10dp：顶栏和底部两行贴着描边看着像被裁掉了半行，往中间收一点，
        中间大字块 weight=1 会把多出来的高度吃掉，所以视觉重心不变。
        左右 7dp：4dp 时状态图标几乎压在描边上。
    -->
    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <!-- 1) 型号（左） + 信号/制式/电量（右上角） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/iv_router"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="3dp"
                android:src="@drawable/ic_router"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/tv_model"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="#777777"
                android:textSize="12sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end" />

            <ImageView
                android:id="@+id/iv_signal_bars"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_signal_0"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/iv_network"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="1dp"
                android:src="@drawable/ic_network_4g"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/tv_no_network"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="1dp"
                android:text="无网络"
                android:textColor="#777777"
                android:textSize="8sp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/iv_battery"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginStart="3dp"
                android:src="@drawable/ic_battery_0"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/tv_battery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="1dp"
                android:text="--"
                android:textColor="#777777"
                android:textSize="12sp"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- 2) 本月流量大数字：weight 吃掉全部剩余高度 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:gravity="bottom">

                <TextView
                    android:id="@+id/tv_flow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#777777"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/tv_flow_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:layout_marginBottom="2dp"
                    android:text="GB"
                    android:textColor="#777777"
                    android:textSize="12sp"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_flow_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="本月流量"
                android:textColor="#777777"
                android:textSize="10sp"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- 分隔线 -->
        <FrameLayout
            android:id="@+id/divider_flow"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="3dp"
            android:background="#E5E5E5" />

        <!-- 3) 今日流量（信号/制式已上移到顶栏，这行只剩流量） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_daily_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="3dp"
                android:text="今日"
                android:textColor="#777777"
                android:textSize="10sp"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tv_daily"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="#777777"
                android:textSize="14sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tv_daily_unit"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:text="GB"
                android:textColor="#777777"
                android:textSize="10sp"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- 4) 温度 + dBm + 更新时间 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/iv_temp"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_temp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/tv_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="1dp"
                android:text="--"
                android:textColor="#777777"
                android:textSize="10sp"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tv_signal_dbm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="--"
                android:textColor="#777777"
                android:textSize="10sp"
                android:includeFontPadding="false"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tv_update_time"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:gravity="end"
                android:text="--"
                android:textColor="#777777"
                android:textSize="10sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- 错误覆盖层 -->
    <LinearLayout
        android:id="@+id/widget_error_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        android:clickable="false">

        <ImageView
            android:id="@+id/widget_error_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_router_off"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/widget_error_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="设备连接失败"
            android:textColor="#777777"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- 重试提示。没有这个控件时 applyStateOverlay 写的「请稍候」会被静默丢掉，
             用户只看到一个转圈图标 -->
        <TextView
            android:id="@+id/widget_error_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text=""
            android:textColor="#777777"
            android:textSize="9sp" />
    </LinearLayout>

</FrameLayout>
